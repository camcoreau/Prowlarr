FROM lscr.io/linuxserver/prowlarr:latest

LABEL org.opencontainers.image.title="CamCore Prowlarr"
LABEL org.opencontainers.image.description="Prowlarr with CamCore branding"

COPY frontend/src/Content/Images/logo-full.png /app/prowlarr/bin/UI/Content/Images/logo-full.png
COPY frontend/src/login.html /app/prowlarr/bin/UI/login.html
COPY frontend/src/Content/camcore-header.css /app/prowlarr/bin/UI/Content/camcore-header.css

RUN find /app/prowlarr/bin/UI -maxdepth 1 -type f -name '*.js' \
      -exec sed -i \
        -e 's#/Content/Images/logo\.png#/Content/Images/logo-full.png#g' \
        -e 's/alt:"Prowlarr Logo"/alt:"CamCore"/g' {} + \
 && grep -qs '/Content/Images/logo-full.png' /app/prowlarr/bin/UI/*.js \
 && sed -i 's#</head>#<link rel="stylesheet" href="/Content/camcore-header.css" /></head>#' /app/prowlarr/bin/UI/index.html \
 && grep -q 'camcore-header.css' /app/prowlarr/bin/UI/index.html
